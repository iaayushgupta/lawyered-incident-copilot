# ─────────────────────────────────────────────────────────────────────────────
# AI Legal Incident Copilot — environment configuration
#
# The prototype runs with ZERO configuration. Every value below is OPTIONAL and
# only used to swap deterministic mock providers for real ones in production.
# With no .env at all, the app uses fully deterministic, offline mock providers.
# ─────────────────────────────────────────────────────────────────────────────

# --- Provider selection (default: "mock" for all) --------------------------------
# Set to "real" to use the corresponding real-provider adapter (not implemented in
# the prototype — adapters throw "not configured" so mistakes fail loudly).
UNDERSTANDING_PROVIDER=mock          # mock | real
DOCUMENT_PROVIDER=mock               # mock | real
RETRIEVAL_PROVIDER=mock              # mock | real
RECOMMENDATION_PROVIDER=mock         # mock | real

# --- Deterministic error injection ------------------------------------------------
# Controlled from the in-app Observability panel by default. These env vars set the
# initial global default. Comma-separated list of fault ids (see lib/providers/faults.ts)
# e.g. INJECT_FAULTS=ocr_digit_swap,hallucinated_citation
INJECT_FAULTS=

# --- Real provider credentials (UNUSED in prototype; documented for production) ---
# WhatsApp Business Cloud API
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Speech-to-text (e.g. self-hosted Whisper / Google STT)
# STT_ENDPOINT=
# OCR / document intelligence (e.g. Azure Document Intelligence)
# OCR_ENDPOINT=
# OCR_KEY=
# LLM (e.g. Anthropic)
# ANTHROPIC_API_KEY=
# Vector DB for legal retrieval
# VECTOR_DB_URL=
# Postgres (production DB; prototype uses in-memory seeded store)
# DATABASE_URL=postgresql://user:pass@localhost:5432/lawyered
